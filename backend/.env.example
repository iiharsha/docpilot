# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Migrations need a SESSION connection. Either of these works:
#   direct:         postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
#   session pooler: postgresql://postgres.<ref>:<pw>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Do NOT use the transaction pooler (same host, port 6543) — alembic refuses it.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_PASSWORD="your-db-password"
# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding width is not an env var: it is a column type, fixed in
# app/database/models/constants.py.

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
